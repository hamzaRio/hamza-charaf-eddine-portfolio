# The public origin this site is deployed at, with no trailing slash,
# e.g. https://hamza-charaf-eddine.vercel.app
#
# Used to build absolute canonical URLs, Open Graph / Twitter URLs and
# images, and the sitemap. Falls back to http://localhost:3000 for local
# development when unset, so this file only needs to be copied to
# .env.local (or set in your hosting provider's project settings) once a
# real production domain exists.
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example.com
